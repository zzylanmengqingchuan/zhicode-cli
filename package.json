{
  "name": "zhiwen",
  "version": "1.0.0",
  "description": "知文：AI 命令行助手，基于 LangChain ReAct Agent，支持多模型（Kimi/DeepSeek/GLM 等）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zhiwen": "dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc && rm -rf dist/src/agent/skills && cp -r src/agent/skills dist/src/agent/skills && cp src/agent/permission/dangerous-path.json dist/src/agent/permission/ && cp src/agent/hooks/hooks.json dist/src/agent/hooks/ && chmod +x dist/src/index.js",
    "start": "node --env-file=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "zzylanmengqingchuan",
  "docs": "https://github.com/zzylanmengqingchuan/zhicode-cli",
  "license": "ISC",
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@playwright/mcp": "^0.0.82",
    "@types/better-sqlite3": "^9.6.0",
    "@types/figlet": "^1.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.16",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.13",
    "@langchain/tavily": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "figlet": "^1.11.4",
    "langchain": "^1.5.11",
    "zod": "^4.6.5"
  }
}
